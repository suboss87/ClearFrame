# Copy to .env and fill in to run against the live TwelveLabs API.
# With no key set, the demo runs in mock mode using fixtures.
TL_API_KEY=
TL_BASE_URL=https://api.twelvelabs.io/v1.3

# Database: leave unset to use local SQLite (clearframe.db). To use Supabase,
# paste the connection string from Supabase -> Project Settings -> Database ->
# Connection string (URI). Prefer the pooled "Transaction"/"Session" pooler URI.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Supabase Storage for uploaded videos (leave unset to keep files on local disk).
#   SUPABASE_URL          Project URL, e.g. https://[PROJECT].supabase.co
#   SUPABASE_SERVICE_KEY  service_role key (Project Settings -> API). SERVER-SIDE ONLY.
#   SUPABASE_BUCKET       a Storage bucket you created, e.g. "creatives"
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=creatives
